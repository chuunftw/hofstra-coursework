<Window x:Class="ChatGPTMulti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT Multi" Width="1200" Height="850" MinWidth="640" MinHeight="480"
        Background="#212121" Foreground="#EEEEEE" WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEEEEE" />
      <Setter Property="Background" Value="#303030" />
      <Setter Property="BorderBrush" Value="#505050" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#484848" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B8D9FF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#606060" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#181818" Padding="6,4">
      <WrapPanel>
        <Button x:Name="BackButton" Content="Back" ToolTip="Back (Alt+Left)" Click="BackClick" IsEnabled="False" />
        <Button x:Name="ForwardButton" Content="Forward" ToolTip="Forward (Alt+Right)" Click="ForwardClick" IsEnabled="False" />
        <Button Content="Refresh" ToolTip="Refresh (Ctrl+R)" Click="RefreshClick" />
        <Button Content="Home" ToolTip="Open ChatGPT home" Click="HomeClick" />
        <Button Content="Split right" ToolTip="Split the active chat to the right (Ctrl+\)" Click="SplitRightClick" />
        <Button Content="Split below" ToolTip="Split the active chat below (Ctrl+Shift+\)" Click="SplitBelowClick" />
        <Button Content="New chat pane" ToolTip="Open ChatGPT home in another pane" Click="NewPaneClick" />
        <Button Content="App" Click="AppMenuClick" ToolTip="Application menu">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="New Window" InputGestureText="Ctrl+N" Click="NewWindowClick" />
              <MenuItem Header="Open Current Chat in New Window" InputGestureText="Ctrl+Shift+N" Click="DuplicateClick" />
              <Separator />
              <MenuItem Header="Exit all windows" InputGestureText="Ctrl+Shift+Q" Click="ExitAllClick" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#181818" Padding="10,3">
      <TextBlock x:Name="PaneCount" FontSize="11" Foreground="#BBBBBB" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid x:Name="WorkspaceHost" />
  </DockPanel>
</Window>
