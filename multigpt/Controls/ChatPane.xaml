<UserControl x:Class="ChatGPTMulti.Controls.ChatPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#212121" Foreground="#EEEEEE" Focusable="False">
  <Border x:Name="PaneBorder" BorderBrush="#3B3B3B" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="#252525" Padding="9,3" MouseLeftButtonDown="HeaderClick">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Close" Padding="6,2" Click="CloseClick" ToolTip="Close this pane" />
          <StackPanel>
            <TextBlock x:Name="PaneTitle" Text="ChatGPT" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PageStatus" Text="Starting browser..." FontSize="10" Foreground="#BBBBBB" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="NoticePanel" Grid.Row="1" Background="#473B22" Padding="8,4" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Dismiss" Padding="5,2" Click="DismissClick" />
          <Button DockPanel.Dock="Right" Content="Retry" Padding="5,2" Click="RefreshClick" />
          <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid x:Name="BrowserHost" />
        <Border x:Name="RightDropTarget" Grid.Column="1" Width="46" Background="#242B2A" BorderBrush="#425850" BorderThickness="1,0,0,0"
                AllowDrop="True" Tag="Right" DragEnter="DropOver" DragOver="DropOver" DragLeave="DropLeave" Drop="DropChat"
                ToolTip="Drag a chat from the ChatGPT sidebar here to open it on the right">
          <TextBlock Text="Drop&#10;chat&#10;here&#10;→" Foreground="#BCD5CC" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False" />
        </Border>
      </Grid>
      <Border x:Name="BelowDropTarget" Grid.Row="3" Height="29" Background="#242B2A" BorderBrush="#425850" BorderThickness="0,1,0,0"
              AllowDrop="True" Tag="Below" DragEnter="DropOver" DragOver="DropOver" DragLeave="DropLeave" Drop="DropChat"
              ToolTip="Drag a chat from the ChatGPT sidebar here to open it below">
        <TextBlock Text="Drop a sidebar chat here to split below ↓" Foreground="#BCD5CC" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False" />
      </Border>
    </Grid>
  </Border>
</UserControl>
